        "esbuild": "0.28.2",
        "esbuild-plugin-inline-worker": "0.1.1",
        "eslint-plugin-obsidianmd": "0.5.1",
        "globals": "17.14.0",
        "jiti": "2.7.0",
        "obsidian": "1.14.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    }
