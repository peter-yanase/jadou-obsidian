{
  "name": "jadou",
  "version": "1.0.5",
  "description": "In-context Japanese language toolbox.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "Japanese",
    "dictionary",
    "morphological analysis",
    "furigana",
    "sentence segmenting"
  ],
  "license": "PolyForm Perimeter v1.0.1",
  "author": "Peter Yanase",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@patdx/kuromoji": "1.0.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-inline-worker": "0.1.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
